{
  "entities": {
    "SensorData": {
      "title": "Sensor Data Reading",
      "description": "Real-time reading from the super-absorbent material sensors.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "moisture": { "type": "number", "description": "Moisture level (0-100%)" },
        "ph": { "type": "number", "description": "pH level (0-14)" },
        "temperature": { "type": "number", "description": "Temperature in Celsius" },
        "pressure": { "type": "number", "description": "Pressure in mmHg" }
      },
      "required": ["timestamp", "moisture", "ph", "temperature", "pressure"]
    },
    "HealthInsight": {
      "title": "AI Health Insight",
      "description": "Insight generated by AI based on sensor data.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["normal", "warning", "critical"] },
        "prediction": { "type": "string" },
        "recommendation": { "type": "string" }
      },
      "required": ["timestamp", "status", "prediction", "recommendation"]
    }
  },
  "firestore": {
    "/readings/{readingId}": {
      "schema": "SensorData",
      "description": "Collection of real-time sensor readings."
    },
    "/insights/{insightId}": {
      "schema": "HealthInsight",
      "description": "Collection of AI-generated health insights."
    }
  }
}
